PORT=3089

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_kalkulasi_db

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h

# ── HTTPS (self-signed internal) ──
# Cert dibuat via: npm run gencert (hasil: certs/*.pem)
HTTPS_PORT=8443
# HTTP lama redirect ke HTTPS; set false untuk mode dev (HTTP tetap serve normal)
HTTPS_REDIRECT=true
# SSL_KEY=./certs/kalkulasi-key.pem
# SSL_CERT=./certs/kalkulasi-cert.pem

# ── Frontend dist yang diserve backend (satu origin dgn API) ──
# FRONTEND_DIST=../kalkulasi_frontend/dist

# ── Server file gambar desain Minta Harga ──
# MINTAHARGA_IMAGE_BASE=http://103.94.238.252:8182/images/mintaharga
